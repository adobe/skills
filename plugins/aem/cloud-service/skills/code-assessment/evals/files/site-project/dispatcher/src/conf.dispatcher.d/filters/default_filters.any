#
# This is the default filter ACL specifying what requests are handled by the dispatcher.
#
# DO NOT EDIT this file, your changes will have no impact on your deployment.
#
# Instead modify filters.any.
#

# deny everything and allow specific entries
/aem0001 { /type "deny"  /url "*" }

# This rule allows content to be access
/aem0010 { /type "allow" /extension '(css|eot|gif|ico|jpeg|jpg|js|gif|pdf|png|svg|swf|ttf|woff|woff2|html|mp4|mov|m4v)' /path "/content/*" }

# Enable clientlibs proxy servlet
/aem0012 { /type "allow" /method "GET" /url "/etc.clientlibs/*" }

# Deny authoring query params
/aem0018 { /type "deny" /method "GET" /query "debug=*" }
/aem0019 { /type "deny" /method "GET" /query "wcmmode=*" }
