{
  "version": 1,
  "description": "Deterministic integration signatures for the migration skill's integrationDiscovery (integration-scan). Scanner behaviour, scoring, and privacy rules: discovery.md.",
  "categories": {
    "adobe-product": "Adobe product integration",
    "third-party": "Known third-party integration",
    "customer-external": "Customer-specific / unknown external integration"
  },
  "considerations": {
    "adobe-product-configuration": "Re-create the Adobe product integration as an IMS-based cloud configuration under /conf (legacy /etc/cloudservices configurations are not supported on AEM as a Cloud Service)",
    "external-connectivity": "Outbound connectivity from AEM as a Cloud Service (advanced networking if the endpoint allowlists IPs)",
    "private-connectivity": "Private / on-premise endpoint: needs advanced networking (VPN or dedicated egress)",
    "non-standard-port": "Endpoint uses a port other than 80/443: needs advanced networking (flexible port egress) and port forwarding rules",
    "credential-configuration": "Move credentials to Cloud Manager secret environment variables",
    "environment-variable-configuration": "Endpoint configured per environment via Cloud Manager environment variables",
    "frontend-integration": "Client-side integration: verify CSP, clientlibs and CDN caching",
    "backend-verification": "Server-side verification call from AEM",
    "binary-transfer": "Binary transfer through the JVM: review against Cloud Service binary handling guidance",
    "cdn-configuration": "AEM as a Cloud Service ships an Adobe-managed CDN: a customer-managed CDN must be reviewed against Cloud Service CDN guidance",
    "cache-invalidation": "CDN purge / invalidation logic must be reviewed against the Cloud Service CDN",
    "customer-review": "Unknown external API: confirm owner, protocol and authentication with the customer"
  },
