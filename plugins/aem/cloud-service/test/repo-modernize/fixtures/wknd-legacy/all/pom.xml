<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.adobe.aem.guides</groupId>
    <artifactId>aem-guides-wknd</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>aem-guides-wknd.all</artifactId>
  <packaging>content-package</packaging>
  <name>Wknd - All</name>
  <description>All content package for Wknd</description>
  <dependencies>
    <dependency>
      <groupId>com.adobe.aem.guides</groupId>
      <artifactId>aem-guides-wknd.ui.apps</artifactId>
      <version>1.0-SNAPSHOT</version>
      <type>zip</type>
    </dependency>
    <dependency>
      <groupId>com.adobe.aem.guides</groupId>
      <artifactId>aem-guides-wknd.ui.content</artifactId>
      <version>1.0-SNAPSHOT</version>
      <type>zip</type>
    </dependency>
    <dependency>
      <groupId>com.adobe.aem.guides</groupId>
      <artifactId>aem-guides-wknd.oak-indexes</artifactId>
      <version>1.0-SNAPSHOT</version>
      <type>zip</type>
    </dependency>
    <dependency>
      <groupId>net.engio</groupId>
      <artifactId>mbassador</artifactId>
      <version>1.3.2</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.jackrabbit</groupId>
        <artifactId>filevault-package-maven-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <group>com.wknd</group>
          <packageType>container</packageType>
          <skipSubPackageValidation>true</skipSubPackageValidation>
          <embeddeds>
            <embedded>
              <groupId>com.adobe.aem.guides</groupId>
              <artifactId>aem-guides-wknd.ui.apps</artifactId>
              <type>zip</type>
              <target>/apps/wknd-packages/application/install</target>
            </embedded>
            <embedded>
              <groupId>com.adobe.aem.guides</groupId>
              <artifactId>aem-guides-wknd.ui.content</artifactId>
              <type>zip</type>
              <target>/apps/wknd-packages/content/install</target>
            </embedded>
            <embedded>
              <groupId>com.adobe.aem.guides</groupId>
              <artifactId>aem-guides-wknd.oak-indexes</artifactId>
              <type>zip</type>
              <target>/apps/wknd-packages/application/install</target>
            </embedded>
            <embedded>
              <groupId>com.adobe.aem.guides</groupId>
              <artifactId>aem-guides-wknd.core</artifactId>
              <type>jar</type>
              <target>/apps/wknd-packages/application/install</target>
            </embedded>
            <embedded>
              <groupId>com.adobe.aem.guides</groupId>
              <artifactId>aem-guides-wknd.bundle2</artifactId>
              <type>jar</type>
              <target>/apps/wknd-packages/application/install</target>
            </embedded>
            <embedded>
              <groupId>net.engio</groupId>
              <artifactId>mbassador</artifactId>
              <target>/apps/wknd-packages/application/install</target>
            </embedded>
          </embeddeds>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.day.jcr.vault</groupId>
        <artifactId>content-package-maven-plugin</artifactId>
        <extensions>true</extensions>
        <configuration>
          <verbose>true</verbose>
          <failOnError>true</failOnError>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.adobe.aem</groupId>
        <artifactId>aemanalyser-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>aem-analyser</id>
            <goals>
              <goal>project-analyse</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>autoInstallSinglePackage</id>
      <activation />
      <build>
        <plugins>
          <plugin>
            <groupId>com.day.jcr.vault</groupId>
            <artifactId>content-package-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>install-package</id>
                <goals>
                  <goal>install</goal>
                </goals>
                <configuration>
                  <targetURL>http://${aem.host}:${aem.port}/crx/packmgr/service.jsp</targetURL>
                  <failOnError>true</failOnError>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
