{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adobe.com/aem/eds-personalization/0.1/decision-request.schema.json",
  "title": "Decision engine request (v1)",
  "description": "Body the skill POSTs to a decision engine: one request per page in the browser, or per HTML response at the edge. No personal data: only these fields are sent.",
  "type": "object",
  "required": [
    "version",
    "page",
    "placeholders",
    "context",
    "mode"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1"
    },
    "page": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 256
        },
        "locale": {
          "type": "string",
          "maxLength": 35
        },
        "title": {
          "description": "The page's public title (document.title in the browser, <title> at the edge). Optional.",
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "placeholders": {
      "description": "One entry per api section on the page.",
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "candidates"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "maxLength": 64
          },
          "candidates": {
            "description": "The section's variant names plus \"default\" (the authored content).",
            "type": "array",
            "minItems": 1,
            "maxItems": 21,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "contains": {
              "const": "default"
            }
          },
          "fragments": {
            "description": "Path of each candidate's fragment, so an engine can read or describe it. default has none.",
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^/fragments/[A-Za-z0-9/_-]+$"
            }
          },
          "hint": {
            "description": "The section's Personalization Hint row, when set.",
            "type": "string",
            "maxLength": 500
          },
          "descriptions": {
            "description": "The section's Personalization Description rows, when set; the key default describes the authored content. Without it, an engine that needs the default reads the section from the published page (page.path, section id).",
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 600
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "required": [
        "consent"
      ],
      "additionalProperties": false,
      "properties": {
        "geo": {
          "type": "object",
          "required": [
            "country"
          ],
          "additionalProperties": false,
          "properties": {
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "region": {
              "type": "string",
              "pattern": "^[A-Z0-9]{1,3}$"
            }
          }
        },
        "device": {
          "type": "string",
          "maxLength": 32
        },
        "visitor": {
          "enum": [
            "new",
            "returning"
          ]
        },
        "state": {
          "description": "Page/app state from setState(). Only sent with consent.",
          "$ref": "#/$defs/stringMap"
        },
        "params": {
          "description": "Only utm_* params and params named by param: rules.",
          "$ref": "#/$defs/stringMap"
        },
        "consent": {
          "type": "object",
          "required": [
            "personalization"
          ],
          "additionalProperties": false,
          "properties": {
            "personalization": {
              "type": "boolean"
            }
          }
        },
        "referrer": {
          "description": "Host name of the page the visitor came from, only when it is another site. Never the path or query.",
          "type": "string",
          "pattern": "^[a-z0-9.-]+$",
          "maxLength": 253
        }
      }
    },
    "mode": {
      "enum": [
        "client",
        "edge"
      ]
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "maxLength": 256
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      }
    }
  }
}
