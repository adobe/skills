{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "adobe-for-developers",
  "version": "1.0.0",
  "description": "Search the developer.adobe.com docs. Manage Adobe Developer Console projects, workspaces, APIs, and credentials. Create and test I/O Events registrations and subscriber defined filters.",
  "author": {
    "name": "Adobe Inc.",
    "url": "https://www.adobe.com"
  },
  "license": "Apache-2.0",
  "keywords": [
    "adobe",
    "adobe-developer-platform",
    "developer-console",
    "credentials",
    "io-events",
    "documentation",
    "mcp"
  ],
  "extensions": {
    "io.github.ai-ecoverse.x927": {
      "targets": {
        "claude": {
          "displayName": "Adobe for Developers",
          "privacyPolicyUrl": "https://www.adobe.com/privacy/policy.html"
        },
        "tessl": {
          "name": "adobe/adobe-for-developers",
          "private": false
        }
      },
      "marketplace": {
        "author": {
          "name": "Adobe"
        }
      }
    }
  }
}
