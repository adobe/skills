{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:mcp__.*[Aa][Dd][Oo][Bb][Ee].*[Ff][Oo][Rr].*[Dd][Ee][Vv][Ee][Ll][Oo][Pp][Ee][Rr][Ss].*__|[Aa][Dd][Oo][Bb][Ee]-[Ff][Oo][Rr]-[Dd][Ee][Vv][Ee][Ll][Oo][Pp][Ee][Rr][Ss]-)(delete_credential|delete_event_registration|delete_project|delete_subscriber_filter|delete_workspace|unsubscribe_credential_from_service|unsubscribe_admin_enterprise_credential_from_service)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/requireApproval.sh\" || printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"The approval check could not run. Confirm this Adobe Developer Console deletion before approving.\"}}'",
            "windows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/requireApproval.ps1\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
