    "creative-cloud",
    "image-editing",
    "design"
  ],
  "extensions": {
    "io.github.ai-ecoverse.x927": {
      "targets": {
        "claude": {
          "privacyPolicyUrl": "https://www.adobe.com/privacy/policy.html",
          "skills": "./skills"
        },
        "tessl": {
          "name": "adobe/adobe-for-creativity",
          "private": false
        }
      }
    }
