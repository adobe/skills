# Copy this file to .env and fill in the values for your deployment type.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
# SaaS:          https://na1.api.commerce.adobe.com/<tenant_id>/
# PaaS/On-Prem:  https://yourcommerce.com/rest/default/
COMMERCE_BASE_URL=

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# SaaS (IMS OAuth)
# Docs: https://developer.adobe.com/commerce/extensibility/starter-kit/checkout/connect/#adobe-identity-management-service-ims
# ---------------------------------------------------------------------------
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRETS=[""]
OAUTH_TECHNICAL_ACCOUNT_ID=
OAUTH_TECHNICAL_ACCOUNT_EMAIL=
OAUTH_IMS_ORG_ID=
OAUTH_SCOPES=[""]

# ---------------------------------------------------------------------------
# PaaS / On-Premise (Commerce Integration)
# Docs: https://developer.adobe.com/commerce/extensibility/starter-kit/checkout/connect/#create-a-commerce-integration
# ---------------------------------------------------------------------------
COMMERCE_CONSUMER_KEY=
COMMERCE_CONSUMER_SECRET=
COMMERCE_ACCESS_TOKEN=
COMMERCE_ACCESS_TOKEN_SECRET=
