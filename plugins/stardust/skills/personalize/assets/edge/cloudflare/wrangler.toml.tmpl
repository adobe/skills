# Generated by the stardust personalize skill from adobe/aem-cloudflare-prod-worker.
name = "{{WORKER_NAME}}"
main = "src/index.mjs"
workers_dev = true
# Production route, e.g. "www.example.com/*"
route = "{{ROUTE}}"
# Cloudflare account ID
account_id = "{{ACCOUNT_ID}}"

compatibility_date = "2025-03-17"

[vars]
ORIGIN_HOSTNAME = "{{ORIGIN_HOSTNAME}}"
# Decision engine for `source | api` placeholders (optional).
# PZN_API_ENDPOINT = "https://decide.example.com/v1"

# Optional: rate-limit the /pzn/decide route per client IP (Workers Rate Limiting).
# The route is public, so set this before pointing the browser at it.
# [[ratelimits]]
# name = "PZN_RATE_LIMITER"
# namespace_id = "1001"
#   [ratelimits.simple]
#   limit = 60
#   period = 60   # seconds: 10 or 60

# Optional and not recommended: disable push invalidation
# PUSH_INVALIDATION = "disabled"

# Secrets: never put them here. Use
#   npx wrangler secret put PZN_API_KEY
#   npx wrangler secret put ORIGIN_AUTHENTICATION   (only for protected sites)
