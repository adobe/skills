   "items": [
    {
     "role": "eyebrow",
     "order": 0,
     "text": "Kind by design"
    },
    {
     "role": "heading",
     "order": 1,
     "text": "Nothing wasted, right down to the grounds."
    },
    {
     "role": "body",
     "order": 2,
     "text": "The Atelier keeps an eye on your beans and reorders before you run low, in packaging that returns to the earth as easily as it arrived. It even bags the spent grounds, ready for the garden."
    },
    {
     "role": "eyebrow",
     "order": 3,
     "text": "Compostable pods"
    },
    {
     "role": "eyebrow",
     "order": 4,
     "text": "Plastic-free refills"
    },
    {
     "role": "eyebrow",
     "order": 5,
     "text": "Reorders itself"
    },
    {
     "role": "eyebrow",
