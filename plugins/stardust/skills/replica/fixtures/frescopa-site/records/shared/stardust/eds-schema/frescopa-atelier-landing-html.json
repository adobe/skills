   "section": "lp-pillars",
   "items": [
    {
     "role": "eyebrow",
     "order": 0,
     "text": "Ritual, meet intelligence"
    },
    {
     "role": "heading",
     "order": 1,
     "text": "Barista craft, with a mind of its own."
    },
    {
     "role": "heading",
     "order": 2,
     "text": "It learns you"
    },
    {
     "role": "body",
     "order": 3,
     "text": "A cup or two in, it starts to memorise your taste. Soon the first pour of the day simply arrives the way you like it."
    },
    {
     "role": "heading",
     "order": 4,
     "text": "It reads the room"
    },
    {
     "role": "body",
     "order": 5,
     "text": "A slow Sunday and a full calendar call for different cups. The Atelier adjusts to the shape of your day."
    },
    {
     "role": "heading",
     "order": 6,
     "text": "Nothing wasted"
    },
    {
     "role": "body",
     "order": 7,
     "text": "It reorders beans before you run out and sends the grounds back to soil. Care, right down to the last cup."
    }
   ],
