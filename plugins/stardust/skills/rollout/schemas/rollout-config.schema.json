{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stardust.dev/schemas/rollout-config.schema.json",
  "title": "stardust rollout/rollout.json",
  "description": "Top-level config + run summary for a full-site rollout to AEM Edge Delivery Services. Owned by stardust:rollout. Keeps all platform/full-site state out of the agnostic core (state.json is never touched).",
  "type": "object",
  "required": ["_provenance", "target", "site"],
  "additionalProperties": false,
  "properties": {
    "_provenance": { "$ref": "#/$defs/provenance" },
    "target": {
      "type": "string",
      "const": "aem-eds",
      "description": "Delivery target. Fixed to AEM Edge Delivery Services for this proposal."
    },
    "site": {
      "type": "object",
      "required": ["sourceUrl"],
      "additionalProperties": false,
      "properties": {
        "sourceUrl": { "type": "string", "format": "uri", "description": "The original site being migrated." },
        "da": {
          "type": "object",
          "description": "DA (da.live) destination coordinates for the DA Source API push.",
          "additionalProperties": false,
          "properties": {
            "org": { "type": "string" },
            "site": { "type": "string" },
            "ref": { "type": "string", "default": "main" }
          }
        },
        "liveHost": { "type": ["string", "null"], "description": "Resolved aem.live host, e.g. main--site--org.aem.live (with or without a scheme; scripts normalise on read)." }
      }
    },
    "links": {
      "type": "object",
      "description": "Link policy read by verify.",
      "additionalProperties": false,
      "properties": {
        "outsideInventory": { "type": "string", "enum": ["fail", "warn"], "default": "fail", "description": "What an internal link to a path that is no coverage row does to the page: fail = the page is failed; warn = recorded in delivery.outsideLinks, the page stays verified." }
      }
    },
    "lastRun": {
      "type": ["object", "null"],
      "description": "Summary of the most recent rollout run (the dashboard headline reads this).",
      "additionalProperties": false,
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "pages": { "$ref": "#/$defs/counts" },
        "blocks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "converted": { "type": "integer", "minimum": 0 },
            "pending": { "type": "integer", "minimum": 0 },
            "ewHeld": { "type": "integer", "minimum": 0, "description": "Blocks past pending whose delivery.ewGate is fail | unmeasured — not counted as converted (measured-gates.md § Gate 6)." }
          }
        },
        "verifyFailures": { "type": "integer", "minimum": 0 },
        "gates": {
          "type": "object",
          "description": "Site-wide roll-up per ingested gate, recomputed from every coverage row's delivery.gates.<name> by update-coverage --gate / verify --ai-readability (reference/measured-gates.md § Gate 5, § Gate 6). The Phase H Readability / Editability lines are computed from here, never typed.",
          "additionalProperties": false,
          "properties": {
            "ai-readability": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "strictMedian": { "type": ["number", "null"] },
                "codeMedian": { "type": ["number", "null"] },
                "below": { "type": "integer", "minimum": 0, "description": "Measured pages with code < min (each is a failed row)." },
                "unmeasured": { "type": "integer", "minimum": 0, "description": "Rows the instrument gave no verdict for — never counted as failed." },
                "measured": { "type": "integer", "minimum": 0 },
                "min": { "type": ["number", "null"], "description": "The bar, copied from the artifact (never retyped)." },
                "at": { "type": ["string", "null"], "format": "date-time" }
              }
            },
            "editability": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "authored": { "type": "integer", "minimum": 0 },
                "editable": { "type": "integer", "minimum": 0 },
                "dead": { "type": "integer", "minimum": 0 },
                "exempt": { "type": "integer", "minimum": 0 },
                "unmeasured": { "type": "integer", "minimum": 0 },
                "pagesFailed": { "type": "integer", "minimum": 0 },
                "measured": { "type": "integer", "minimum": 0 },
                "at": { "type": ["string", "null"], "format": "date-time" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["writtenBy", "writtenAt", "stardustVersion"],
      "properties": {
        "writtenBy": { "type": "string", "examples": ["stardust:rollout"] },
        "writtenAt": { "type": "string", "format": "date-time" },
        "stardustVersion": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "verified": { "type": "integer", "minimum": 0 },
        "deployed": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "contentPending": { "type": "integer", "minimum": 0 },
        "stale": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
